            { "name": "E", "numbers": ["6"], "type": "input" },
            { "spacer": 1 },
            { "name": "V0", "numbers": ["3"], "type": "input" }
          ],
          "right": [
            { "name": "DB0", "numbers": ["7", "8", "9", "10", "11", "12", "13", "14"],
              "type": "bidirectional", "increment": true }
          ],
          "top": [
