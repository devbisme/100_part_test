            { "name": "A", "numbers": ["15"], "type": "power_in" }
          ],
          "bottom": [
            { "name": "VSS", "numbers": ["1"], "type": "power_in" },
            { "name": "K", "numbers": ["16"], "type": "power_in" }
          ]
        }
      ]
